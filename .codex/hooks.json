{
  "description": "Block broker mutation tools. Edgecraft is paper-only.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "(^exec$|.*(place|cancel)_(equity|option)_order$)",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/scripts/deny_broker_tools.py\"",
            "timeout": 10,
            "statusMessage": "Blocking broker mutation tools"
          }
        ]
      }
    ]
  }
}
